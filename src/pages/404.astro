---
import Layout from '../layouts/Layout.astro';
import {locales,pathFor} from '../data/locales';
const l=locales[0];
---
<Layout locale={l} noindex><main id="main" class="not-found wrap"><p class="eyebrow">404 / MouseEffect</p><h1>{l.error[0]}</h1><p>{l.error[1]}</p><a class="button" href="/">{l.nav.back} ↗</a><ul>{locales.map(other=><li lang={other.lang} dir={other.dir}><a href={pathFor(other.code)}>{other.name}</a></li>)}</ul></main></Layout>
