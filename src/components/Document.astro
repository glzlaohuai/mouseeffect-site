---
import Layout from '../layouts/Layout.astro';
import {pathFor,type Locale} from '../data/locales';
const {locale:l,page} = Astro.props as {locale:Locale;page:'privacy'|'support'};
const content=l[page];
---
<Layout locale={l} page={page}>
<main id="main" class="document wrap">
  <div class="document-top"><a class="text-link" href={pathFor(l.code)}><span aria-hidden="true">↖ </span>{l.nav.back}</a><p class="eyebrow">MouseEffect / Hiimob Apps</p><h1>{l.nav[page]}</h1><p class="lead">{content.intro}</p>{page==='privacy' && <p class="effective">{l.common.updated}</p>}</div>
  <div class="document-grid"><aside class="contents"><p>{l.common.contents}</p><ol>{content.sections.map((section,i)=><li><a href={`#section-${i+1}`}>{section[0]}</a></li>)}</ol></aside><article class="prose">{content.sections.map((section,i)=><section id={`section-${i+1}`}><span class="section-number">{String(i+1).padStart(2,'0')}</span><h2>{section[0]}</h2><p>{section[1]}</p></section>)}<div class="contact-line"><a class="button" href="mailto:494763134@qq.com">{l.nav.contact} ↗</a><a class="email" href="mailto:494763134@qq.com">494763134@qq.com</a></div>{page==='privacy' && <div class="provider-links"><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub · {l.nav.privacy} ↗</a><a href="https://www.apple.com/legal/privacy/">Apple · {l.nav.privacy} ↗</a></div>}</article></div>
</main>
</Layout>
